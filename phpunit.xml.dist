<?xml version="1.0" encoding="UTF-8"?>
<!--
    Defaults point at the test server from docker-compose.yml.
    To test another server, copy this file to phpunit.xml (git-ignored) and change the values,
    or set the variables in the environment (environment variables take precedence).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="examples">
            <directory>examples</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <env name="SMTP_HOSTNAME" value="127.0.0.1"/>
        <env name="SMTP_PORT" value="2525"/>
        <env name="SMTP_SSL_PORT" value="4650"/>
        <env name="SMTP_SUBMISSION_PORT" value="5870"/>
        <env name="SMTP_USERNAME" value="username"/>
        <env name="SMTP_PASSWORD" value="password"/>
        <env name="SMTP_EXISTING_EMAIL" value="existing@example.com"/>
        <!-- examples/: an address on a domain the server must NOT relay to without login -->
        <env name="SMTP_RELAY_RECIPIENT" value="someone@example.org"/>
        <!-- examples/: port to test pregreet detection on (usually SMTP_PORT) -->
        <env name="SMTP_PREGREET_PORT" value="2526"/>
        <!-- examples/: verify certificates (trusted chain, valid for SMTP_EXPECTED_HOSTNAME) -->
        <env name="SMTP_VERIFY_TLS" value="true"/>
        <!-- examples/: the name the server should present in its certificate, greeting and EHLO -->
        <env name="SMTP_EXPECTED_HOSTNAME" value="mail.example.com"/>
        <!-- examples/: CA to trust instead of the system CAs (empty: system CAs) -->
        <env name="SMTP_CA_FILE" value="docker/postfix/tls/ca.pem"/>
        <!-- examples/: fail if the certificate expires within this many days -->
        <env name="SMTP_CERT_MIN_DAYS" value="14"/>
    </php>
</phpunit>
